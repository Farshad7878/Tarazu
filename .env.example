APP_NAME="ترازو"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# در محیط توسعه APP_DEBUG=true بگذارید (خطاهای کامل نمایش داده می‌شوند). در production حتماً false باشد.
APP_URL=http://localhost

APP_TIMEZONE=Asia/Tehran

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# مدت اعتبار توکن ورود به دقیقه (۷۲۰ = ۱۲ ساعت). پس از آن کاربر باید دوباره وارد شود.
SANCTUM_TOKEN_EXPIRATION=720
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (اعلان‌های زنده: سفارش جدید برای ادمین، اعلان تخفیف برای ریسپشن)
# نکته: QUEUE_CONNECTION=database یعنی برای ارسال، worker باید اجرا باشد: php artisan queue:work
REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# متغیرهای فرانت (Vite)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# پیامک: SMS_DRIVER=log (پیش‌فرض، فقط در لاگ) یا kavenegar (کلید واقعی لازم است)
SMS_DRIVER=log
SMS_KAVENEGAR_API_KEY=
SMS_SENDER=
# ارسال پیامک تشکر بعد از هر سفارش (هزینه دارد؛ پیش‌فرض خاموش)
SMS_ORDER_THANK_YOU=false

# بازگشت کالا: تعداد روزی که پس از خرید، سفارش هنوز قابل بازگشت است
RETURN_WINDOW_DAYS=30

# نرخ ارزش افزوده (درصد) - ۰ یعنی غیرفعال. قیمت‌ها شامل مالیات فرض می‌شوند.
VAT_RATE=0

# پشتیبان‌گیری: تعداد نسخه‌های نگه‌داری‌شده (پیش‌فرض ۱۴). پشتیبان شبانه با زمان‌بند Laravel (php artisan schedule:run در cron) ساخته می‌شود.
BACKUP_KEEP=14

# گیفت کارت: مدت اعتبار به روز (پیش‌فرض ۳۶۵)
GIFT_CARD_VALIDITY_DAYS=365
